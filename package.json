{
  "name": "lao-ukrainian-phonetic-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "generate:web-data": "python scripts/generate_web_data.py",
    "test": "node --test web/engine.test.js tests/romanization.test.mjs tests/romanization-syllable-engine.test.mjs tests/web-layout.test.mjs",
    "test:browser": "playwright test",
    "build": "npm run generate:web-data && python scripts/build_web.py",
    "check:release": "npm test && npm run build && npm run test:browser"
  },
  "devDependencies": { "@playwright/test": "1.63.0" }
}
